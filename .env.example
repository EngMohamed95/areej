# MySQL / PHP API settings. Copy to .env and fill with the hosting values.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u000000000_areej_menu"
DB_USER="u000000000_areej_api"
DB_PASSWORD="CHANGE_ME"

# Four-digit manager PIN. Only its SHA-256 hash is written to PHP config.
ADMIN_PIN="0000"

# FTP deployment settings (optional when uploading through File Manager).
FTP_HOST="ftp.areej-sa.net"
FTP_USER="u000000000.areej"
FTP_PASSWORD="CHANGE_ME"
FTP_REMOTE_DIR="./"
